<Window x:Class="FreeVpn.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Free VPN" Height="640" Width="900"
        MinHeight="520" MinWidth="720"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Free VPN" FontSize="24" FontWeight="Bold"/>
                <TextBlock Text="Powered by VPN Gate — free public relay servers"
                           Foreground="{StaticResource MutedBrush}" FontSize="12"/>
            </StackPanel>
            <Border Grid.Column="1" x:Name="StatusPill" CornerRadius="14"
                    Background="{StaticResource PanelBrush}" Padding="14,8"
                    VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="StatusDot" Width="10" Height="10"
                             Fill="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="StatusText" Text="Disconnected" Margin="8,0,0,0"
                               VerticalAlignment="Center" FontWeight="SemiBold"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Toolbar -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="RefreshButton" Grid.Column="0" Style="{StaticResource GhostButton}"
                    Content="↻  Refresh servers" Width="170" Height="38" Click="OnRefresh"/>

            <!-- Filter by country -->
            <Border Grid.Column="1" Background="{StaticResource PanelBrush}" CornerRadius="8"
                    Height="38" Margin="10,0,10,0">
                <Grid>
                    <TextBlock x:Name="FilterHint" Text="Filter by country (e.g. France, Germany, UK)…"
                               Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"
                               Margin="12,0,0,0" IsHitTestVisible="False"/>
                    <TextBox x:Name="FilterBox" Background="Transparent" BorderThickness="0"
                             Foreground="{StaticResource TextBrush}" VerticalContentAlignment="Center"
                             Padding="12,0,12,0" TextChanged="OnFilterChanged" CaretBrush="White"/>
                </Grid>
            </Border>

            <CheckBox Grid.Column="2" x:Name="SortByPing" Content="Sort by ping"
                      Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"
                      Margin="0,0,14,0" Click="OnSortChanged"/>
            <TextBlock Grid.Column="3" x:Name="CountText" Text=""
                       Foreground="{StaticResource MutedBrush}"
                       VerticalAlignment="Center"/>
        </Grid>

        <!-- Server list -->
        <Border Grid.Row="2" Background="{StaticResource PanelBrush}" CornerRadius="12" Padding="4">
            <Grid>
                <ListView x:Name="ServerList" Background="Transparent" BorderThickness="0"
                          Foreground="{StaticResource TextBrush}"
                          SelectionMode="Single"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Location" Width="300"
                                            DisplayMemberBinding="{Binding Display}"/>
                            <GridViewColumn Header="Ping" Width="110"
                                            DisplayMemberBinding="{Binding PingText}"/>
                            <GridViewColumn Header="Speed" Width="130"
                                            DisplayMemberBinding="{Binding SpeedMbps}"/>
                            <GridViewColumn Header="Protocol" Width="90"
                                            DisplayMemberBinding="{Binding Protocol}"/>
                            <GridViewColumn Header="Sessions" Width="90"
                                            DisplayMemberBinding="{Binding Sessions}"/>
                            <GridViewColumn Header="Host" Width="130"
                                            DisplayMemberBinding="{Binding HostName}"/>
                        </GridView>
                    </ListView.View>
                </ListView>

                <StackPanel x:Name="LoadingPanel" Visibility="Collapsed"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock x:Name="LoadingText" Text="Loading free servers…"
                               Foreground="{StaticResource MutedBrush}" FontSize="14"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Connect button -->
        <Button x:Name="ConnectButton" Grid.Row="3" Margin="0,14,0,0"
                Style="{StaticResource AccentButton}"
                Content="Connect" Click="OnConnectClick" IsEnabled="False"/>

        <!-- Log -->
        <Expander Grid.Row="4" Header="Connection log" Margin="0,10,0,0"
                  Foreground="{StaticResource MutedBrush}">
            <Border Background="#FF0C0E13" CornerRadius="8" Margin="0,6,0,0">
                <TextBox x:Name="LogBox" Height="120" IsReadOnly="True"
                         Background="Transparent" Foreground="#FF9AA4B2"
                         BorderThickness="0" FontFamily="Consolas" FontSize="11"
                         VerticalScrollBarVisibility="Auto"
                         TextWrapping="NoWrap" Padding="8"/>
            </Border>
        </Expander>
    </Grid>
</Window>
