<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>FreeVpn</RootNamespace>
    <AssemblyName>FreeVpn</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.0.1</Version>
    <AssemblyTitle>Free VPN</AssemblyTitle>
    <Product>Free VPN</Product>
    <Company>Free VPN (VPN Gate client)</Company>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <!-- Single-file friendly settings; final publish is driven by CI. -->
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <None Update="Assets\app.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
