<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.WorldClock" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <item name="colorPrimary">@color/accent_blue</item>
        <item name="colorPrimaryVariant">@color/accent_blue_light</item>
        <item name="colorOnPrimary">@color/text_primary</item>
        <item name="colorSecondary">@color/night_color</item>
        <item name="colorOnSecondary">@color/text_primary</item>
        <item name="android:colorBackground">@color/bg_primary</item>
        <item name="android:windowBackground">@color/bg_primary</item>
        <item name="android:statusBarColor">@color/status_bar_color</item>
        <item name="android:navigationBarColor">@color/bg_primary</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="toolbarStyle">@style/Widget.WorldClock.Toolbar</item>
        <item name="materialCardViewStyle">@style/Widget.WorldClock.CardView</item>
        <item name="snackbarStyle">@style/Widget.WorldClock.Snackbar</item>
    </style>

    <style name="Widget.WorldClock.Toolbar" parent="Widget.MaterialComponents.Toolbar">
        <item name="android:background">@color/toolbar_color</item>
        <item name="titleTextColor">@color/text_primary</item>
    </style>

    <style name="Widget.WorldClock.CardView" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/bg_card</item>
        <item name="cardElevation">0dp</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="strokeColor">@color/divider</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Widget.WorldClock.Snackbar" parent="Widget.MaterialComponents.Snackbar">
        <item name="android:background">@color/snackbar_bg</item>
    </style>

    <style name="Theme.WorldClock.NoActionBar" parent="Theme.WorldClock">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>
</resources>
