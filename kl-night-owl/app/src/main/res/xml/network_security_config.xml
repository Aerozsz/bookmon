<?xml version="1.0" encoding="utf-8"?>
<!--
  Older Android versions (8.x) miss some of the root certificates that the OpenStreetMap servers
  use (Let's Encrypt). Trust them in addition to the phone's own list so live updates work there.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="@raw/isrg_root_x1" />
            <certificates src="@raw/isrg_root_x2" />
        </trust-anchors>
    </base-config>
</network-security-config>
